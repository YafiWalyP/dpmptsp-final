<!-- =====================================================
     JAVASCRIPT
====================================================== -->

<script>

  /* =====================================================
     SEARCH + KATEGORI ARTIKEL
  ===================================================== */

  const mediaSearch = document.getElementById("media-search");
  const mediaItems = Array.from(document.querySelectorAll(".media-item"));
  const mediaEmpty = document.getElementById("media-empty");
  const articleCategories = Array.from(document.querySelectorAll(".article-tab"));

  let activeCategory = "semua";

  function filterMedia() {

    const keyword = String(mediaSearch?.value || "")
      .toLowerCase()
      .trim();

    let visible = 0;

    mediaItems.forEach((item) => {

      const title = String(item.getAttribute("data-title") || "")
        .toLowerCase();

      const category = String(item.getAttribute("data-category") || "lainnya")
        .toLowerCase();

      const searchMatch =
        !keyword ||
        title.includes(keyword) ||
        category.includes(keyword);

      const categoryMatch =
        activeCategory === "semua" ||
        category === activeCategory;

      const show = searchMatch && categoryMatch;

      item.classList.toggle("hidden", !show);

      if (show) visible++;
    });

    mediaEmpty?.classList.toggle("hidden", visible !== 0);
  }

  articleCategories.forEach((button) => {

    button.addEventListener("click", (event) => {

      event.preventDefault();

      activeCategory = button.getAttribute("data-category") || "semua";

      articleCategories.forEach((btn) => {
        const active = btn === button;
        btn.classList.toggle("active", active);
        btn.setAttribute("aria-pressed", active ? "true" : "false");
      });

      filterMedia();
    });

  });

  mediaSearch?.addEventListener("input", filterMedia);

  filterMedia();

  /* =====================================================
     SHARE URL
  ===================================================== */

  const currentUrl =
    window.location.href;


  const pageTitle =
    document.title;


  const articleLink =
    document.getElementById(
      "article-link"
    );


  if (articleLink) {

    articleLink.value =
      currentUrl;

  }


  /* =====================================================
     FACEBOOK
  ===================================================== */

  const facebook =
    document.getElementById(
      "share-facebook"
    );


  if (facebook) {

    facebook.href =
      `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;

  }


  /* =====================================================
     X
  ===================================================== */

  const twitter =
    document.getElementById(
      "share-twitter"
    );


  if (twitter) {

    twitter.href =
      `https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(pageTitle)}`;

  }


  /* =====================================================
     WHATSAPP
  ===================================================== */

  const whatsapp =
    document.getElementById(
      "share-whatsapp"
    );


  if (whatsapp) {

    whatsapp.href =
      `https://wa.me/?text=${encodeURIComponent(
        pageTitle + " " + currentUrl
      )}`;

  }


  /* =====================================================
     COPY LINK
  ===================================================== */

  const copyButton =
    document.getElementById(
      "copy-link"
    );


  const copyMessage =
    document.getElementById(
      "copy-message"
    );


  async function copyLink() {

    try {

      await navigator.clipboard.writeText(
        currentUrl
      );


      if (copyMessage) {

        copyMessage.classList.remove(
          "hidden"
        );


        setTimeout(
          () => {

            copyMessage.classList.add(
              "hidden"
            );

          },
          2500
        );

      }

    }

    catch {

      if (articleLink) {

        articleLink.select();

        document.execCommand(
          "copy"
        );

      }

    }

  }


  copyButton?.addEventListener(
    "click",
    copyLink
  );


  /* =====================================================
     READING PROGRESS
  ===================================================== */

  const progress =
    document.getElementById(
      "reading-progress"
    );


  function updateProgress() {

    if (!progress) {

      return;

    }


    const scrollTop =
      window.scrollY;


    const height =
      document.documentElement
        .scrollHeight -
      window.innerHeight;


    const percent =
      height > 0
        ? (
            scrollTop /
            height
          ) * 100
        : 0;


    progress.style.width =
      `${Math.min(
        100,
        Math.max(
          0,
          percent
        )
      )}%`;

  }


  window.addEventListener(
    "scroll",
    updateProgress,
    {
      passive: true
    }
  );


  updateProgress();


  /* =====================================================
     BACK TO TOP
  ===================================================== */

  const backTop =
    document.getElementById(
      "back-to-top"
    );


  function updateBackTop() {

    if (!backTop) {

      return;

    }


    if (
      window.scrollY > 500
    ) {

      backTop.classList.remove(
        "hidden"
      );

      backTop.classList.add(
        "flex"
      );

    }

    else {

      backTop.classList.add(
        "hidden"
      );

      backTop.classList.remove(
        "flex"
      );

    }

  }


  window.addEventListener(
    "scroll",
    updateBackTop,
    {
      passive: true
    }
  );


  backTop?.addEventListener(
    "click",
    () => {

      window.scrollTo(
        {
          top: 0,
          behavior: "smooth"
        }
      );

    }
  );


  updateBackTop();

</script>

