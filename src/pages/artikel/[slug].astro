export const prerender = false;

import MainLayout from "../../layouts/MainLayout.astro";
import { db } from "../../lib/db.js";
import { slugify } from "../../utils/slugify";

const rawSlug = Astro.params.slug || "";

/* =========================================================
   NORMALISASI SLUG
========================================================= */
function normalizeSlug(value = "") {
  return decodeURIComponent(String(value))
    .toLowerCase()
    .trim()
    .replace(/\+/g, "-")
    .replace(/[^a-z0-9\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "");
}

const urlSlug = normalizeSlug(rawSlug);

/* =========================================================
   AMBIL POST
========================================================= */
let rows = [];

try {
  const [result] = await db.execute(`
    SELECT p.*, c.title AS category_title
    FROM post p
    LEFT JOIN category_berita c ON c.id_category = p.id_category
    WHERE p.title IS NOT NULL
      AND p.title != ''
    ORDER BY p.date DESC
  `);
  rows = result || [];
} catch (error) {
  console.error("DB ERROR POST :", error);
  rows = [];
}

/* =========================================================
   CARI POST DETAIL
========================================================= */
let post = null;

post = rows.find((row) => {
  if (!row?.title) return false;
  return normalizeSlug(slugify(row.title)) === urlSlug;
});

if (!post) {
  post = rows.find((row) => {
    if (!row?.title) return false;
    return normalizeSlug(row.title) === urlSlug;
  });
}

if (!post && urlSlug) {
  post = rows.find((row) => {
    if (!row?.title) return false;
    const dbSlug = normalizeSlug(row.title);
    return dbSlug.includes(urlSlug) || urlSlug.includes(dbSlug);
  });
}

if (!post) {
  console.error("POST TIDAK DITEMUKAN:", urlSlug);
  throw new Error(`Data tidak ditemukan untuk slug: ${urlSlug}`);
}

/* =========================================================
   KATEGORI
========================================================= */
let categories = [];

try {
  const [result] = await db.execute(`
    SELECT id_category, title
    FROM category_berita
    ORDER BY id_category ASC
  `);
  categories = result || [];
} catch (error) {
  console.error("DB ERROR KATEGORI :", error);
  categories = [];
}

function getCategoryType(item) {
  const name = String(
    item?.category_title ||
    item?.category ||
    item?.nama_category ||
    ""
  )
    .replace(/<[^>]*>/g, "")
    .trim()
    .toLowerCase();

  // UTAMAKAN NAMA KATEGORI DARI DATABASE.
  if (name === "berita" || name.includes("berita")) return "berita";
  if (name === "artikel" || name.includes("artikel")) return "artikel";

  // Fallback ID lama, hanya jika nama kategori tidak tersedia.
  const id = Number(item?.id_category || 0);
  if (id === 1 || id === 8) return "berita";
  if (id === 2 || id === 3) return "artikel";

  return "lainnya";
}

/* =========================================================
   NAMA + KEY KATEGORI
========================================================= */
let kategoriKey = getCategoryType(post);
let namaKategori = kategoriKey === "berita" ? "Berita" : "Artikel";

if (post?.category_title) {
  namaKategori = String(post.category_title)
    .replace(/<[^>]*>/g, "")
    .trim() || namaKategori;
}

/* =========================================================
   BERITA / ARTIKEL TERBARU
   Penting: deklarasikan BERITA LAINNYA sebelum semua turunannya.
========================================================= */
let beritaLainnya = [];

try {
  const [result] = await db.execute(`
    SELECT p.*, c.title AS category_title
    FROM post p
    LEFT JOIN category_berita c ON c.id_category = p.id_category
    WHERE p.title IS NOT NULL
      AND p.title != ''
    ORDER BY p.date DESC, p.id_post DESC
    LIMIT 1000
  `);
  beritaLainnya = result || [];
} catch (error) {
  console.error("DB ERROR BERITA :", error);
  beritaLainnya = [];
}

function sortTerbaru(a, b) {
  const dateA = `${a?.date || ""} ${a?.time || ""}`;
  const dateB = `${b?.date || ""} ${b?.time || ""}`;
  return dateB.localeCompare(dateA);
}

const mediaList = [...beritaLainnya]
  .filter((item) => ["berita", "artikel"].includes(getCategoryType(item)))
  .sort(sortTerbaru);

const beritaMedia = mediaList
  .filter((item) => getCategoryType(item) === "berita");

const artikelMedia = mediaList
  .filter((item) => getCategoryType(item) === "artikel");

const totalBerita = beritaMedia.length;
const totalArtikel = artikelMedia.length;

/* Semua item untuk daftar utama/sidebar.
   Filter tab akan menentukan mana yang terlihat. */
const mediaListDisplay = mediaList;

const beritaList = beritaMedia.slice(0, 5);
const artikelList = artikelMedia.slice(0, 5);

/* =========================================================
   KATEGORI SIDEBAR
========================================================= */
let artikel = [];

try {
  const [result] = await db.execute(`
    SELECT *
    FROM category_berita
    ORDER BY id_category ASC
  `);
  artikel = result || [];
} catch (error) {
  console.error("DB ERROR KATEGORI SIDEBAR :", error);
  artikel = [];
}

/* =========================================================
   FORMAT TANGGAL
========================================================= */
function formatDate(date) {
  if (!date) return "—";

  const parsed = new Date(date);
  if (Number.isNaN(parsed.getTime())) return String(date);

  return parsed.toLocaleDateString("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric"
  });
}

/* =========================================================
   URL GAMBAR
========================================================= */
function imageUrl(picture) {
  const value = String(picture || "").trim();

  if (!value) return "/images/placeholder-news.jpg";
  if (/^https?:\/\//i.test(value)) return value;
  if (value.startsWith("/")) return value;

  return `https://dpm-ptsp.surabaya.go.id/fileberita/${value}`;
}

console.log("[MEDIA DETAIL]", {
  slug: urlSlug,
  post: post?.title,
  categoryId: post?.id_category,
  kategoriKey,
  namaKategori,
  totalRows: rows.length,
  totalMedia: mediaList.length,
  totalBerita,
  totalArtikel
});
